{
  "framework": null,
  "rewrites": [
    {
      "source": "/offerte",
      "destination": "/offerte.html"
    },
    {
      "source": "/offerte/",
      "destination": "/offerte.html"
    },
    {
      "source": "/admin/offerte",
      "destination": "/admin-offers.html"
    },
    {
      "source": "/admin/offerte/",
      "destination": "/admin-offers.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'"
        }
      ]
    }
  ]
}
